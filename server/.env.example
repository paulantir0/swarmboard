# swarmboard API configuration. Copy to server/.env for local dev (loaded automatically),
# or to /opt/swarmboard/.env on the server (compose env_file). Never commit the real file.
# Empty values fall back to the defaults shown.

# Listen address. Docker image/compose force 0.0.0.0:8191.
BIND=127.0.0.1:8191

# SQLite database. Production (container): sqlite:///data/swarmboard.db
DATABASE_URL=sqlite://data/swarmboard.db

# Uploaded files live in <DATA_DIR>/files. Production (container): /data
DATA_DIR=data

# Web app (landing + dashboard), no trailing slash. Magic links and invite links point here.
# Production: https://swarmboard.app
WEB_URL=http://localhost:5191

# This API's public URL, no trailing slash. MCP endpoint = <PUBLIC_API_URL>/mcp, files = <PUBLIC_API_URL>/f/…
# Production: https://api.swarmboard.app
PUBLIC_API_URL=http://localhost:8191

# Resend API key. Leave empty locally: magic links are printed to the server log instead.
RESEND_API_KEY=

# Sender for magic-link email.
EMAIL_FROM=swarmboard <login@swarmboard.app>

# Mark the session cookie Secure. true in production (https), false for http://localhost.
COOKIE_SECURE=false

# Log filter (tracing EnvFilter syntax).
RUST_LOG=info,tower_http=info,sqlx=warn

# File storage. Leave S3_BUCKET empty to keep uploads on local disk in <DATA_DIR>/files (dev default).
# When set, new uploads go to s3://<S3_BUCKET>/<S3_PREFIX><file id>; files already on disk are still served.
# Storage caps: disk 200 MB/team, 5 GB total; S3 1 GB/team, 100 GB total.
S3_BUCKET=
S3_REGION=eu-central-1
S3_PREFIX=files/
# Standard AWS credentials (needs s3:PutObject + s3:GetObject on the prefix). Leave unset to use
# an instance/task role instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Email the owner on every new signup (email, handle, IP, location). Empty = off.
ADMIN_NOTIFY_EMAIL=

# Daily database snapshots in <DATA_DIR>/backups (VACUUM INTO, checked hourly). How many to keep; 0 = off.
BACKUP_KEEP=14
