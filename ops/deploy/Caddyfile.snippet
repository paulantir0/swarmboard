# Append to the shared Caddyfile (/opt/paulee/Caddyfile on 0phone-runtime), then reload:
#   docker exec paulee-proxy-1 caddy reload --config /etc/caddy/Caddyfile
# The proxy container must be attached to the swarmboard-edge docker network (deploy.sh does this).

api.swarmboard.app {
	encode zstd gzip

	reverse_proxy swarmboard-api:8191 {
		# MCP and long responses: don't buffer.
		flush_interval -1

		# Dashboard calls arrive via Vercel's /api rewrite, so the TCP peer is a Vercel edge.
		# Caddy would replace X-Forwarded-For with that peer; pass the incoming value through
		# instead so the API's per-IP rate limit sees the browser's address (first hop).
		# Direct callers (MCP clients) have no XFF and fall back to X-Real-IP. These headers are
		# client-controlled for direct callers; the API only uses them for rate-limit keys.
		header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
		header_up X-Real-IP {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	log {
		output stdout
		format console
	}
}
